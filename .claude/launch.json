{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv\\Scripts\\streamlit.exe",
      "runtimeArgs": ["run", "web/app.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
