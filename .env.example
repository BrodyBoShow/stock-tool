# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# Supabase Postgres connection string (Session/Transaction pooler URI).
DATABASE_URL=

# Contact string sent to SEC EDGAR, e.g. "Your Name your@email.com".
SEC_USER_AGENT=

# Anthropic API key for filing summaries (used in a later phase).
ANTHROPIC_API_KEY=

# FRED API key for macro context ingestion (scripts/ingest_macro.py).
# Free key: https://fredaccount.stlouisfed.org/apikeys
# Only needs to be a GitHub Actions secret if/when macro ingestion is scheduled.
FRED_API_KEY=
