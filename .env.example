# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# Supabase Postgres connection string (Session/Transaction pooler URI).
DATABASE_URL=

# Contact string sent to SEC EDGAR, e.g. "Your Name your@email.com".
SEC_USER_AGENT=

# Anthropic API key — powers the on-demand AI filing summarizer (Phase 10,
# engine/summarize.py). Summaries are generated per company on request and
# cached by accession, so cost scales with use. https://console.anthropic.com
ANTHROPIC_API_KEY=

# FRED API key for macro context ingestion (scripts/ingest_macro.py).
# Free key: https://fredaccount.stlouisfed.org/apikeys
# The nightly workflow now refreshes macro automatically — add this as a GitHub
# Actions secret (FRED_API_KEY) too, or the nightly macro step is skipped and
# rates/VIX won't refresh overnight.
FRED_API_KEY=

# EIA API key for the forward commodity backdrop (scripts/ingest_commodity_forecasts.py).
# Free key: https://www.eia.gov/opendata/register.php
# Pulls the EIA Short-Term Energy Outlook (STEO) oil & gas price FORECASTS into
# commodity_forecasts — CONTEXT ONLY, never feeds factor scores; powers the
# deep-dive "forward commodity backdrop" caveat for oil & gas producers. Add it
# as a GitHub Actions secret (EIA_API_KEY) too, or the nightly forecast step is
# skipped. The API server does NOT need this (it reads the ingested table).
EIA_API_KEY=

# Tiingo API key — optional alternative EOD price provider
# (scripts/backfill_prices_bulk.py --provider tiingo). Free key: tiingo.com.
# NOTE: Tiingo's FREE tier allows only ~500 unique symbols/month, so it suits
# watchlist-scale jobs / fallback, not the full ~5.5k-name nightly (yfinance
# remains the default there). A paid Tiingo plan lifts the caps.
TIINGO_API_KEY=

# Massive (formerly Polygon.io) — the nightly's PRIMARY EOD price + corporate-
# action source. Free "Stocks Basic" key: massive.com. Its Grouped Daily endpoint
# returns the whole US market's OHLCV in ONE request, so the nightly is ~1 call
# per trading day (well inside the free 5 req/min). When this key is set the
# nightly uses Massive and falls back to yfinance on error/thin coverage; set
# PRICE_SOURCE=yfinance to force the old path. Add a GitHub Actions secret
# (MASSIVE_API_KEY) too, or CI nightly stays on yfinance. MASSIVE_BASE_URL
# overrides the host (api.polygon.io and api.massive.com are equivalent).
MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.polygon.io
# PRICE_SOURCE=massive

# --- API server (FastAPI) deployment vars, read by api/main.py ---
# Access gate: set this to ANY value → the whole API requires an X-App-Password
# header matching it (private mode); leave empty → fully public. This is the
# private↔public switch (no code change). See DEPLOY.md.
APP_ACCESS_PASSWORD=

# Comma-separated extra browser origins allowed by CORS (e.g. your deployed
# frontend URL: https://stockbud.vercel.app). localhost dev origins are always
# allowed, so this stays empty for local dev.
ALLOWED_ORIGINS=

# --- Per-user auth (multi-tenancy, Phase 1) — read by api/auth.py ---
# Supabase verifies each user's login token to scope their data (owner_id).
# SUPABASE_URL: your project URL, e.g. https://oqweuhwaiknnqupzkmxt.supabase.co
# SUPABASE_JWT_SECRET: Supabase dashboard -> Project Settings -> API ->
#   "JWT Secret" (the HS256 signing secret). Required to verify logins. Add it as
#   a Render secret too. (If your project uses the newer asymmetric signing keys,
#   only SUPABASE_URL is needed — verification falls back to the project JWKS.)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- AI cost guardrails (api/ratelimit.py) — protect the costly Opus Filing Q&A ---
# Per-account AND service-wide per-DAY caps on the on-demand 10-K Filing Q&A (the
# Opus-class, most expensive AI call) so neither one user nor a crowd of beta
# signups can run up the Anthropic bill. Defaults: 5 per account/day, 40/day total.
# UNCAPPED_EMAILS (comma-separated, case-insensitive) bypass BOTH caps and don't
# count toward the global — set it to your owner login so your account is never
# limited. Tune the numbers without a redeploy via the two AI_CAP_* overrides.
UNCAPPED_EMAILS=
# AI_CAP_PER_ACCOUNT=5
# AI_CAP_GLOBAL=40

# NOTE: the React frontend also needs VITE_API_URL (the backend URL) at build
# time — that is a Vite env var set in the Vercel dashboard, NOT a Python/.env
# value, so it is intentionally not listed here. See DEPLOY.md.

# --- Brokerage linking (SnapTrade personal account) — engine/portfolio_sync.py ---
# Personal SnapTrade accounts use OAuth 2.0 (Authorization Code + PKCE), read-only.
# SNAPTRADE_OAUTH_CLIENT_ID is a public client id minted once via Dynamic Client
# Registration (POST https://api.snaptrade.com/oauth/register/ with your redirect);
# it is NOT a secret. SNAPTRADE_REDIRECT must match the registered redirect (use
# the literal 127.0.0.1 loopback, not localhost). The partner HMAC keys
# (SNAPTRADE_CLIENT_ID/CONSUMER_KEY) are NOT used by personal accounts.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_REDIRECT=http://127.0.0.1:8000/portfolio/links/callback
# (legacy / partner HMAC — unused for personal accounts)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Fernet key that encrypts stored broker OAuth tokens at rest. Generate one with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# (or cryptography's Fernet.generate_key()). Required before linking an account.
PORTFOLIO_TOKEN_KEY=
